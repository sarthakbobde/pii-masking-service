# Fernet key that encrypts the vault: python -m app.cli master-key  (comma-separate keys to rotate; newest first)
PII_MASTER_KEY=
# First admin key, created on start if missing (at least 24 characters). Remove it once you have created others.
PII_BOOTSTRAP_ADMIN_KEY=
# PII_DATABASE_URL=sqlite:///./data/pii.db          # or postgresql+psycopg://user:pass@host/db (install the driver)
# PII_SETTINGS_FILE=settings.example.json           # seeds the settings on first start
# PII_MAX_TEXT_CHARS=200000
# PII_MAX_UPLOAD_MB=20
# PII_DEFAULT_RATE_LIMIT=120
# PII_TESSDATA_DIR=                                 # Tesseract language data for OCR of scanned PDFs
# PII_LOG_LEVEL=INFO
