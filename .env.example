# Optional. Protects the admin page and API (at least 24 characters). Without it they answer only from the server itself.
# The masking API never needs a key.
PII_ADMIN_KEY=
# PII_DATABASE_URL=sqlite:///./data/pii.db          # or postgresql+psycopg://user:pass@host/db (install the driver)
# PII_SETTINGS_FILE=settings.example.json           # seeds the settings and fields on first start
# PII_MAX_UPLOAD_MB=50
# PII_MAX_TEXT_CHARS=200000
# PII_JOB_TTL_MINUTES=60                            # how long a masked CMS document waits to be downloaded
# PII_TESSDATA_DIR=                                 # Tesseract language data for OCR of scanned PDFs
# PII_LOG_LEVEL=INFO
